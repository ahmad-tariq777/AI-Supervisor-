@startuml
!include style.iuml
title AR-2: Deployment Architecture on a Single Application Server
skinparam linetype ortho

node "Client device" {
  artifact "Web browser" as BR
}

node "Application server (Windows or Linux)" {
  node "Nginx\nport 443 (80 redirects)\nPUBLIC" as NG
  node "Express API (Node.js)\nport 5000\nINTERNAL" as API
  node "Python AI Service (Uvicorn)\nport 8000\nINTERNAL" as AIS
  node "Ollama server\nport 11434\nLOCALHOST ONLY" as OL
  node "MongoDB server\nport 27017\nINTERNAL" as MG
  artifact "React build\nstatic files" as RB
  artifact "Vector store files\nChroma or FAISS" as VS
  artifact "Uploaded files and\ntrained model files" as FS
  artifact "Llama 3.2 3B and\nembedding model" as MD
}

cloud "GitHub" as GH
cloud "Research sources" as SRC

BR --> NG : HTTPS
NG ..> RB : serves
NG --> API : proxy /api
API --> MG : Mongoose
API --> AIS : HTTP + service key
API --> GH : HTTPS
API ..> FS
AIS --> OL : HTTP
AIS ..> VS
AIS ..> FS : load models
AIS --> SRC : HTTPS (keywords only)
OL ..> MD
@enduml
